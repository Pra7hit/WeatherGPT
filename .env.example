# WeatherGPT environment
#
# Copy this file to `.env.local` (which is gitignored) and fill in the values.
# Nothing here is read outside src/lib/env.ts and src/services/**, all of which
# import "server-only" - so no key can reach the browser bundle.

# ---------------------------------------------------------------------------
# REQUIRED for the conversational layer
# ---------------------------------------------------------------------------
# Without this the app still runs: /api/chat falls back to a deterministic
# summary built from real weather data, shown behind a visible notice that says
# the LLM is not configured. It will not hold a conversation.
ANTHROPIC_API_KEY=

# Optional. Set only if you route Anthropic traffic through a gateway/proxy
# instead of api.anthropic.com. Leave blank for the official endpoint.
ANTHROPIC_BASE_URL=

# Optional overrides.
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max - reasoning effort for the chat turn.
LLM_EFFORT=low

# ---------------------------------------------------------------------------
# OPTIONAL - official government weather warnings
# ---------------------------------------------------------------------------
# Enables the official-warning channel (OpenWeatherMap One Call 3.0 `alerts[]`,
# which relays IMD warnings for India). Free tier: https://openweathermap.org/api
#
# One Call 3.0 also needs its own "One Call by Call" subscription on the same
# OpenWeatherMap account (free tier: 1000 calls/day, card required to activate).
# A valid key without it answers HTTP 401 and the app then says the official
# channel could not be reached - it does not report "no warning is active".
#
# Without the key at all the app reports honestly that the official channel is
# not configured and offers only forecast-derived advisories, clearly labelled as
# not official. It never invents an official warning.
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# No key needed for any of these (already working out of the box):
#   Open-Meteo forecast + GFS/ICON/ECMWF model output   api.open-meteo.com
#   Open-Meteo ERA5 archive (historical, back to 1940)  archive-api.open-meteo.com
#   Open-Meteo geocoding (city search)                  geocoding-api.open-meteo.com
#   BigDataCloud reverse geocoding (coords -> place)    api.bigdatacloud.net
# ---------------------------------------------------------------------------
